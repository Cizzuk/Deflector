    "Please allow notifications to run the automation. Next, change the alert settings to Notification Center only." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オートメーションを実行するために、通知を許可してください。次にアラートの設定を通知センターのみに変更してください。"
          }
        }
      }
    },
    "Please download \"Deflector Automation\", the automation required to run Deflector. Next, edit the shortcut to enable the notification automation." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deflectorが動作するために必要な「Deflector Automation」をダウンロードしてください。 次にショートカットを編集して、通知のオートメーションを有効にしてください。"
          }
        }
      }
    },
    "Please set the shortcut name to launch the voice assistant." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声アシスタントを起動するショートカットの名前を設定してください。"
