        }
      }
    },
    "If it doesn't work properly, please return to this setup and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正しく動作しない場合は、このセットアップに戻って再度お試しください。"
          }
        }
      }
    },
    "Japan-only. You can change the voice assistant assigned to the Side Button. Use a shortcut to access your favorite voice assistant." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本限定。サイドボタンに割り当てられた音声アシスタントを変更できます。ショートカットを使ってお気に入りの音声アシスタントを使用します。"
          }
        }
      }
    },
    "License" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンス"
          }
        }
      }
