    "Live Activity" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブアクティビティ"
          }
        }
      }
    },
    "Live Activity is active for only 8 hours. To display a Live Activity persistently, create an automation in the Shortcuts to start the activity every 8 hours." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブアクティビティは8時間のみ連続で表示できます。ライブアクティビティを永続的に表示するには、ショートカットでオートメーションを作成して、8時間ごとにアクティビティを開始するように設定してください。"
          }
        }
      }
    },
