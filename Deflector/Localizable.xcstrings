      }
    },
    "Please set the shortcut name to run from the Live Activity." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブアクティビティから実行するショートカットの名前を設定してください。"
          }
        }
      }
    },
    "Please turn on \"Press Side Button for Deflector\" in the Settings. To run the shortcut from the Side Button, the device must be physically located in a region that supports [Side Button Access](https://developer.apple.com/documentation/appintents/launching-your-voice-based-conversational-app-from-the-side-button-of-iphone)." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で「サイドボタンを押してDeflectorを使用」をオンにしてください。サイドボタンからショートカットを実行するには、デバイスが[Side Button Access](https://developer.apple.com/documentation/appintents/launching-your-voice-based-conversational-app-from-the-side-button-of-iphone)をサポートする地域に物理的に存在している必要があります。"
